{
  "name": "axion",
  "version": "0.6.2",
  "description": "A WebGPU, data-oriented 3D engine.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./dist/axion.min.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node test/serve.mjs",
    "build": "node build.mjs",
    "test": "node test/smoke.mjs",
    "test:gpu": "node test/gpu-validate.mjs && node test/gpu-validate.mjs test/regressions.html && node test/gpu-validate.mjs test/trap-check.html && node test/gpu-validate.mjs test/robustness.html && node test/gpu-validate.mjs test/rerun-check.html && node test/gpu-validate.mjs test/snapshot-check.html",
    "test:bundle": "node build.mjs && node test/gpu-validate.mjs test/bundle-check.html",
    "prepublishOnly": "node build.mjs",
    "fetch:sponza": "node scripts/fetch-sponza.mjs",
    "test:sponza": "node test/gpu-validate.mjs test/sponza-check.html",
    "pack:sponza": "node scripts/pack-sponza.mjs",
    "test:sponza-packed": "node test/gpu-validate.mjs test/sponza-packed-check.html",
    "test:features": "node test/gpu-validate.mjs test/features-check.html"
  },
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "acorn": "^8.18.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.49.1",
    "sharp": "^0.35.4"
  },
  "unpkg": "dist/axion.min.js",
  "jsdelivr": "dist/axion.min.js",
  "keywords": [
    "webgpu",
    "3d",
    "engine",
    "renderer",
    "ecs",
    "wgsl",
    "pbr"
  ]
}
